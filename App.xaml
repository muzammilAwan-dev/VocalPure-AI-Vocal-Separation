<Application x:Class="VocalPure.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VocalPure.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ============================================================ -->
            <!-- COLOR PALETTE - High Contrast Dark Theme                     -->
            <!-- ============================================================ -->

            <!-- Background Colors -->
            <SolidColorBrush x:Key="BackgroundPrimary" Color="#0F0F0F"/>
            <SolidColorBrush x:Key="BackgroundSecondary" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="BackgroundTertiary" Color="#252525"/>
            <SolidColorBrush x:Key="BackgroundElevated" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="BackgroundHover" Color="#333333"/>
            <SolidColorBrush x:Key="BackgroundPressed" Color="#3D3D3D"/>

            <!-- Surface Colors -->
            <SolidColorBrush x:Key="SurfacePrimary" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="SurfaceSecondary" Color="#2A2A2A"/>

            <!-- Accent Colors -->
            <SolidColorBrush x:Key="AccentPrimary" Color="#007ACC"/>
            <SolidColorBrush x:Key="AccentSecondary" Color="#0098FF"/>
            <SolidColorBrush x:Key="AccentHover" Color="#1A8CE0"/>
            <SolidColorBrush x:Key="AccentPressed" Color="#005A9E"/>

            <!-- Text Colors -->
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
            <SolidColorBrush x:Key="TextTertiary" Color="#777777"/>
            <SolidColorBrush x:Key="TextMuted" Color="#555555"/>
            <SolidColorBrush x:Key="TextAccent" Color="#4FC3F7"/>

            <!-- Status Colors -->
            <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
            <SolidColorBrush x:Key="WarningColor" Color="#FF9800"/>
            <SolidColorBrush x:Key="ErrorColor" Color="#F44336"/>
            <SolidColorBrush x:Key="InfoColor" Color="#2196F3"/>

            <!-- Border Colors -->
            <SolidColorBrush x:Key="BorderPrimary" Color="#333333"/>
            <SolidColorBrush x:Key="BorderAccent" Color="#007ACC"/>
            <SolidColorBrush x:Key="BorderHover" Color="#444444"/>

            <!-- Progress Bar Colors -->
            <SolidColorBrush x:Key="ProgressBackground" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="ProgressForeground" Color="#007ACC"/>
            <SolidColorBrush x:Key="ProgressSecondary" Color="#00BCD4"/>

            <!-- Drop Zone Colors -->
            <SolidColorBrush x:Key="DropZoneBorder" Color="#444444"/>
            <SolidColorBrush x:Key="DropZoneBorderDragOver" Color="#007ACC"/>
            <SolidColorBrush x:Key="DropZoneBackground" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="DropZoneBackgroundDragOver" Color="#142838"/>

            <!-- Scrollbar Colors -->
            <SolidColorBrush x:Key="ScrollBarThumb" Color="#555555"/>
            <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#666666"/>
            <SolidColorBrush x:Key="ScrollBarTrack" Color="#1A1A1A"/>

            <!-- ============================================================ -->
            <!-- CONVERTERS                                                   -->
            <!-- ============================================================ -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />
            <converters:PhaseToVisibilityConverter x:Key="PhaseToVis" />
            <converters:ProgressToPercentageConverter x:Key="ProgressToPercent" />
            <converters:TimeSpanToStringConverter x:Key="TimeSpanToStr" />
            <converters:PhaseToBrushConverter x:Key="PhaseToBrush" />

            <!-- ============================================================ -->
            <!-- STYLE DEFINITIONS                                            -->
            <!-- ============================================================ -->

            <!-- Window Style -->
            <Style x:Key="MainWindowStyle" TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BackgroundPrimary}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontFamily" Value="Segoe UI, Calibri, Arial"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
            </Style>

            <!-- TextBlock Styles -->
            <Style x:Key="HeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="SubHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            </Style>

            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            </Style>

            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextAccent}"/>
                <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            </Style>

            <!-- Button Style -->
            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentPressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary Button -->
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="{StaticResource BackgroundElevated}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderPrimary}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <!-- Danger Button -->
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="{StaticResource ErrorColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ErrorColor}"/>
            </Style>

            <!-- ProgressBar Style -->
            <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
                <Setter Property="Background" Value="{StaticResource ProgressBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource ProgressForeground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="3"
                                        Height="{TemplateBinding Height}"/>
                                <Border x:Name="PART_Track"
                                        CornerRadius="3"
                                        Height="{TemplateBinding Height}">
                                    <Border x:Name="PART_Indicator"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left">
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="0.6" To="1.0"
                                                            Duration="0:0:1"
                                                            AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ScrollViewer Style -->
            <Style x:Key="DarkScrollViewer" TargetType="ScrollViewer">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>

            <!-- ListBox Style for Job Queue -->
            <Style x:Key="JobListBox" TargetType="ListBox">
                <Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderPrimary}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ListBoxItem Style -->
            <Style x:Key="JobListItem" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BackgroundHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- TextBox Style (Log Display) -->
            <Style x:Key="LogTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderPrimary}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
