<Window x:Class="VocalPure.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VocalPure.ViewModels"
        xmlns:models="clr-namespace:VocalPure.Models"
        Title="VocalPure - AI Vocal Separation"
        Width="920"
        Height="780"
        MinWidth="750"
        MinHeight="550"
        Style="{StaticResource MainWindowStyle}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        mc:Ignorable="d">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="JobItemTemplate" DataType="{x:Type models:SeparationJob}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{Binding FileName}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="350"/>
                    <TextBlock Text=" | "
                               Foreground="{StaticResource TextMuted}"
                               Margin="4,0"/>
                    <TextBlock Text="{Binding FormattedFileSize}"
                               Style="{StaticResource MutedText}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Border Background="{Binding Phase, Converter={StaticResource PhaseToBrush}}"
                            CornerRadius="3"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            Opacity="0.9">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                    
                    <Button Content="✕"
                            Width="20"
                            Height="20"
                            Padding="0"
                            FontSize="10"
                            FontWeight="Bold"
                            ToolTip="Remove from queue"
                            Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Phase}" Value="Idle">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4">
                    <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}"
                                 Maximum="1"
                                 Style="{StaticResource ModernProgressBar}"
                                 Height="4"
                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Visibility="{Binding OutputFilePath, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Output: " Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding OutputFilePath}"
                               Style="{StaticResource MutedText}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="350"/>
                    <Button Content="Open"
                            Style="{StaticResource SecondaryButton}"
                            Padding="8,2"
                            FontSize="10"
                            Margin="8,0,0,0"
                            Command="{Binding DataContext.OpenOutputFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding OutputFilePath}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundSecondary}"
                BorderBrush="{StaticResource BorderPrimary}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Vocal"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Pure"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimary}"/>
                    <TextBlock Text=" | AI Vocal Separation"
                               FontSize="12"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Bottom"
                               Margin="8,0,0,2"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Visibility="{Binding GpuAvailable, Converter={StaticResource BoolToVis}}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#4CAF50"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="GPU Acceleration Active"
                               FontSize="11"
                               Foreground="{StaticResource SuccessColor}"
                               Margin="6,0,0,0"
                               Visibility="{Binding GpuAvailable, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Crafted with ⚡ by muzammilAwan-dev"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenGitHubCommand}"
                            Padding="6,4"
                            ToolTip="Visit GitHub Profile">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GitHub" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding VersionInfo}"
                               Style="{StaticResource MutedText}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                x:Name="DropZoneBorder"
                Background="{StaticResource DropZoneBackground}"
                BorderBrush="{StaticResource DropZoneBorder}"
                BorderThickness="2"
                CornerRadius="8"
                Margin="20,16,20,0"
                Padding="40,30"
                AllowDrop="True"
                DragEnter="OnDragEnter"
                DragLeave="OnDragLeave"
                DragOver="OnDragOver"
                Drop="OnDrop">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Viewbox Width="48" Height="48" Margin="0,0,0,12">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{StaticResource AccentPrimary}"
                                  Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41z"/>
                            <Path Fill="{StaticResource TextMuted}"
                                  Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3zM19,19H5V5h14V19z"/>
                        </Canvas>
                    </Viewbox>

                    <TextBlock Text="{Binding DropZoneText}"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               Foreground="{StaticResource TextSecondary}"
                               TextAlignment="Center"/>

                    <TextBlock Text="Supports MP3, WAV, FLAC, MP4, MKV, and more"
                               HorizontalAlignment="Center"
                               Style="{StaticResource MutedText}"
                               Margin="0,8,0,0"
                               TextAlignment="Center"/>

                    <Button Content="Browse Files..."
                            Style="{StaticResource ActionButton}"
                            Margin="0,16,0,0"
                            Padding="24,10"
                            Command="{Binding BrowseCommand}"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisInverted}}"/>
                </StackPanel>
            </Grid>

            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DropZoneBackgroundDragOver}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource DropZoneBorderDragOver}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource BackgroundSecondary}"
                BorderBrush="{StaticResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="20,12,20,0"
                Padding="16"
                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ActiveJob.FileName}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ActiveJob.StatusMessage}"
                                   Style="{StaticResource StatusText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource BackgroundElevated}"
                            BorderBrush="{StaticResource BorderPrimary}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveJob.ExecutionProvider}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextAccent}"
                                   FontWeight="SemiBold"
                                   FontFamily="Consolas"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <ProgressBar Value="{Binding ActiveJob.OverallProgress, Mode=OneWay}"
                                 Maximum="1"
                                 Height="8"
                                 Style="{StaticResource ModernProgressBar}"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding ActiveJob.OverallProgress, Converter={StaticResource ProgressToPercent}}"
                               Style="{StaticResource StatusText}"
                               FontSize="12"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding ActiveJob.Elapsed, Converter={StaticResource TimeSpanToStr}}"
                               Style="{StaticResource MutedText}"
                               Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="3"
                               Style="{StaticResource MutedText}"
                               Visibility="{Binding ActiveJob.EstimatedRemaining, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="ETC {0}">
                                <Binding Path="ActiveJob.EstimatedRemaining" Converter="{StaticResource TimeSpanToStr}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>

                <Button Grid.Row="3"
                        Content="Cancel Processing"
                        Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0"
                        Padding="16,6"
                        FontSize="12"
                        Command="{Binding CancelCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource BackgroundSecondary}"
                BorderBrush="{StaticResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="20,12,20,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="Output Destination:" 
                           Style="{StaticResource SubHeaderText}" 
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="1" 
                           Text="{Binding DisplayOutputFolder}" 
                           Style="{StaticResource MutedText}" 
                           Foreground="{StaticResource TextAccent}"
                           VerticalAlignment="Center" 
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="2" 
                        Content="Change Folder" 
                        Style="{StaticResource SecondaryButton}" 
                        FontSize="11" 
                        Padding="10,4" 
                        Margin="12,0,0,0"
                        Command="{Binding ChangeOutputFolderCommand}"/>

                <Button Grid.Column="3" 
                        Content="Reset" 
                        Style="{StaticResource DangerButton}" 
                        FontSize="11" 
                        Padding="10,4" 
                        Margin="8,0,0,0"
                        Command="{Binding ResetOutputFolderCommand}"
                        Visibility="{Binding HasCustomOutputFolder, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="20,12,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Processing Queue"
                           Style="{StaticResource SubHeaderText}"
                           Margin="0,0,16,0"/>
                <TextBlock Text="{Binding JobQueue.Count, StringFormat='({0} jobs)'}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"/>
                
                <Button Content="Start Processing"
                        Style="{StaticResource ActionButton}"
                        FontSize="11"
                        Padding="14,4"
                        Margin="16,0,0,0"
                        Command="{Binding StartProcessingCommand}"/>

                <Button Content="Clear Completed"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="11"
                        Padding="10,4"
                        Margin="12,0,0,0"
                        Command="{Binding ClearCompletedCommand}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         Style="{StaticResource JobListBox}"
                         ItemsSource="{Binding JobQueue}"
                         ItemTemplate="{StaticResource JobItemTemplate}"
                         ItemContainerStyle="{StaticResource JobListItem}"
                         Margin="0,0,8,0"/>

                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundSecondary}"
                        BorderBrush="{StaticResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource BackgroundElevated}"
                                BorderBrush="{StaticResource BorderPrimary}"
                                BorderThickness="0,0,0,1"
                                Padding="8,4"
                                CornerRadius="4,4,0,0">
                            <TextBlock Text="Processing Log"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox Style="{StaticResource LogTextBox}"
                                     Text="{Binding ActiveJob.DetailedLog, FallbackValue='Ready to process...', Mode=OneWay}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Margin="4"
                                     TextChanged="LogTextBox_TextChanged"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="5"
                Background="{StaticResource BackgroundSecondary}"
                BorderBrush="{StaticResource BorderPrimary}"
                BorderThickness="0,1,0,0"
                Padding="16,6"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding EngineStatus}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="6" Height="6"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentPrimary}"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1" To="0.3"
                                                        Duration="0:0:0.8"
                                                        AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Text" Value="Idle"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                        <Setter Property="Text" Value="Processing"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
